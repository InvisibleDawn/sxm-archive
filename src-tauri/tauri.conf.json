{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SXM Archive",
  "mainBinaryName": "sxm-archive",
  "version": "3.0.1",
  "identifier": "com.sxm.archive",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SXM Archive",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self' ws://localhost:5173 ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "rpm",
      "deb",
      "msi",
      "nsis",
      "dmg",
      "app"
    ],
    "category": "Utility",
    "shortDescription": "Ouvrir, extraire, créer et protéger des archives",
    "longDescription": "SXM Archive : gestionnaire d'archives RAR, ZIP, 7z et tar.gz avec chiffrement AES-256, conversion entre formats et test d'intégrité. Moteur 7-Zip 25.01 intégré, 100 % hors ligne.",
    "copyright": "© 2026 Invisible_Dawn",
    "publisher": "Invisible_Dawn",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "zip"
        ],
        "name": "Archive ZIP",
        "description": "Archive ZIP",
        "role": "Editor",
        "mimeType": "application/zip"
      },
      {
        "ext": [
          "7z"
        ],
        "name": "Archive 7z",
        "description": "Archive 7z",
        "role": "Editor",
        "mimeType": "application/x-7z-compressed"
      },
      {
        "ext": [
          "rar"
        ],
        "name": "Archive RAR",
        "description": "Archive RAR",
        "role": "Viewer",
        "mimeType": "application/vnd.rar"
      },
      {
        "ext": [
          "tgz"
        ],
        "name": "Archive tar.gz",
        "description": "Archive tar.gz",
        "role": "Editor",
        "mimeType": "application/x-compressed-tar"
      },
      {
        "ext": [
          "gz"
        ],
        "name": "Archive gzip",
        "description": "Archive gzip",
        "role": "Editor",
        "mimeType": "application/gzip"
      }
    ],
    "resources": {
      "bin/": "bin/",
      "../THIRD-PARTY-NOTICES.md": "licenses/THIRD-PARTY-NOTICES.md"
    },
    "linux": {
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "libstdc++",
          "xdg-utils"
        ],
        "recommends": [
          "caja-actions"
        ],
        "release": "1",
        "files": {
          "/usr/share/file-manager/actions/sxm-archive-compress.desktop": "linux/caja-compress.desktop",
          "/usr/share/nemo/actions/sxm-archive-compress.nemo_action": "linux/nemo-compress.nemo_action",
          "/usr/share/licenses/sxm-archive/7-Zip-License.txt": "bin/License.txt",
          "/usr/share/doc/sxm-archive/THIRD-PARTY-NOTICES.md": "../THIRD-PARTY-NOTICES.md"
        },
        "desktopTemplate": "linux/sxm-archive.desktop",
        "postRemoveScript": "linux/postun.sh"
      },
      "deb": {
        "depends": [
          "xdg-utils",
          "libstdc++6"
        ],
        "recommends": [
          "caja-actions"
        ],
        "files": {
          "/usr/share/file-manager/actions/sxm-archive-compress.desktop": "linux/caja-compress.desktop",
          "/usr/share/nemo/actions/sxm-archive-compress.nemo_action": "linux/nemo-compress.nemo_action",
          "/usr/share/doc/sxm-archive/7-Zip-License.txt": "bin/License.txt",
          "/usr/share/doc/sxm-archive/THIRD-PARTY-NOTICES.md": "../THIRD-PARTY-NOTICES.md"
        },
        "desktopTemplate": "linux/sxm-archive.desktop",
        "postRemoveScript": "linux/postrm-deb.sh"
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "languages": [
          "French",
          "English"
        ],
        "installerHooks": "windows/hooks.nsh"
      },
      "wix": {
        "language": "fr-FR"
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc4MEZFQjQwQjcxODRGODYKUldTR1R4aTNRT3NQZUw5eWtOcWJCZDVFUW1CZjFFWUdKbWNBeGIrRHl1UXRCQ3FTdlZzd3dFdFIK",
      "endpoints": [
        "https://github.com/InvisibleDawn/sxm-archive/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
